{
  "sources": {
    "obsidian-kit": {
      "ref": "0.60.1"
    },
    "code-kit": {
      "ref": "0.27.1"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/code-kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "settings",
        "sha256",
        "i18n",
        "safe-markdown"
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "linear-probe"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "secrets"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "confirm",
        "settings_walker",
        "folder-suggest",
        "secrets",
        "help-setting"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "plugin-id"
      ]
    }
  ]
}
